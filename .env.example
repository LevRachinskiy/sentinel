# Local demo only. Production startup refuses anonymous authentication.
DEMO_MODE=true
DATABASE_URL=sqlite:///./sentinel.db
SANDBOX_URL=http://127.0.0.1:8001
SANDBOX_TOKEN=local-sandbox-only
MODEL_PROVIDER=baseline
# Optional: provider is openai or anthropic; a model must be set explicitly.
MODEL_NAME=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Production: DEMO_MODE=false and provide at least one token record as JSON.
# AUTH_TOKENS={"replace-with-long-random-secret":{"tenant":"acme","actor":"lev","role":"operator"}}
